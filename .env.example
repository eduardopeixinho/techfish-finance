APP_NAME="TechFish Finance"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ===========================================
# Banco de Dados (Docker)
# ===========================================
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=techfish_finance
DB_USERNAME=techfish
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret
# Portas no host (só 127.0.0.1); dentro do Docker continuam 3306/6379
DB_FORWARD_PORT=33060

# ===========================================
# Redis (Cache/Sessions/Queues)
# ===========================================
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_FORWARD_PORT=63790

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# ===========================================
# Google OAuth
# ===========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_ALLOWED_DOMAINS=

# ===========================================
# Modo demonstração (botão "Ver demonstração", dados fictícios do DemoSeeder)
# ===========================================
DEMO_MODE=true
DEMO_EMAIL=demo@techfish.test

# ===========================================
# E-mail
# ===========================================
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@techfish.test"
MAIL_FROM_NAME="${APP_NAME}"

# ===========================================
# phpMyAdmin (Docker)
# ===========================================
PHPMYADMIN_PORT=8081

# ===========================================
# AWS (S3, etc.)
# ===========================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ===========================================
# Vite
# ===========================================
VITE_APP_NAME="${APP_NAME}"
